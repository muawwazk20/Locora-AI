# Locora Hyperlocal Discovery Environment Variables

# Google OAuth (custom server flow, used by api/auth/google*)
# SERVER-ONLY. Set these in Vercel > Settings > Environment Variables
# (Production, type: Sensitive) and redeploy. Never prefix them with VITE_
# (that would ship them to the browser) and never commit real values here.
# In Google Cloud Console, register:
#   Authorized JavaScript origins: https://locora-hyperlocal.vercel.app
#   Authorized redirect URIs: https://locora-hyperlocal.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. If unset, the callback URL is derived from the request host.
# GOOGLE_REDIRECT_URI=https://locora-hyperlocal.vercel.app/api/auth/callback/google

# Optional: Google Gemini API Key for AI Google Search Grounding to find real-time events across any city
# Also powers GitHub issue analysis and fix planning.
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Optional: GitHub access token for GitHub issue imports, repo metadata lookups, and PR creation.
# A fine-grained personal access token with repo access is recommended.
GITHUB_TOKEN=

# Keep publication disabled until the server endpoint is access-restricted.
# The page still requires a separate explicit review confirmation.
# GITHUB_PUBLISHING_ENABLED=false

# Optional: Preloaded Docker image used to run imported-repository checks.
# Repository scripts are never executed directly on the Locora host. Use a
# trusted, preloaded image; validation runs without network access and with
# CPU/memory/process limits. Validation stays blocked if unset or Docker is
# unavailable.
# GITHUB_VALIDATION_IMAGE=your-preloaded-trusted-validation-image:tag

# Optional: Ticketmaster API Key for pulling live concert & venue events
# Get your API key at: https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=

# Server Port (AI Studio environment requires 3000)
PORT=3000

# Client Configuration
# Base API URL (defaults to /api when hosted full-stack on the same port)
VITE_API_BASE_URL=/api

# Set to "true" to run with client-side demo storage (localStorage) or leave empty/"false" for full-stack Express backend
VITE_USE_MOCK_API=false
# Shared events database (Supabase) — see SHARED_EVENTS_SETUP.md.
# SERVER-ONLY. Set these in Vercel > Settings > Environment Variables
# (Production, type: Sensitive) and redeploy. Never prefix them with
# VITE_ and never commit real values here. Until they are set, events
# keep working locally in each browser, but are not shared.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
